{
  "name": "splash-e2e",
  "private": true,
  "type": "module",
  "description": "End-to-end tests for the Splash desktop UI (splash-web harness) and web version (splash-server).",
  "scripts": {
    "test": "playwright test",
    "check": "tsc --noEmit && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-testids.ts && node --experimental-strip-types --disable-warning=ExperimentalWarning --test support/agents.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
