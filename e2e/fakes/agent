#!/bin/sh
# One fake for every agent CLI the end-to-end tests install. Link it as
# `claude`, `codex`, `glue`, `pool`, `pi`, `amp` or `npx` in a folder on SPLASH_PATH.
#
# Version and login checks answer like the real CLIs. An ACP launch
# (`npx … <adapter>`, `glue acp`, `pool acp`) is logged to
# $SPLASH_E2E_DIR/launches.jsonl and replaced by fake-acp, configured by files
# in $SPLASH_E2E_DIR:
#
#   <agent>.fixture  recording to replay (default $SPLASH_E2E_FIXTURES/<agent>/read.jsonl)
#   <agent>.flags    extra fake-acp flags, such as --fail-load
#   <agent>.speed    FAKE_ACP_SPEED (default 0: no delays)
#   <agent>.auth     "logged_out" to fail the login check
#
# Every message the agent receives is appended to <agent>.audit.jsonl, every
# one it sends to <agent>.sent.jsonl.
set -eu
dir=${SPLASH_E2E_DIR:?SPLASH_E2E_DIR is not set}
name=$(basename "$0")

json() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

launch() {
	agent=$1
	shift
	argv=""
	for arg in "$@"; do argv="$argv${argv:+,}\"$(json "$arg")\""; done
	printf '{"agent":"%s","argv":[%s],"cwd":"%s","pid":%s}\n' "$agent" "$argv" "$(json "$PWD")" "$$" >>"$dir/launches.jsonl"
	fixture=$(cat "$dir/$agent.fixture" 2>/dev/null || echo "${SPLASH_E2E_FIXTURES:?}/$agent/read.jsonl")
	flags=$(cat "$dir/$agent.flags" 2>/dev/null || true)
	FAKE_ACP_SPEED=$(cat "$dir/$agent.speed" 2>/dev/null || echo 0)
	export FAKE_ACP_SPEED
	# shellcheck disable=SC2086 # the flags file holds separate words
	exec "${SPLASH_E2E_FAKE_ACP:?}" "$fixture" --audit "$dir/$agent.audit.jsonl" --trace "$dir/$agent.sent.jsonl" $flags
}

logged_out() { [ "$(cat "$dir/$1.auth" 2>/dev/null || true)" = logged_out ]; }

has() {
	want=$1
	shift
	for arg in "$@"; do [ "$arg" = "$want" ] && return 0; done
	return 1
}

case "$name" in
npx)
	case "$*" in
	*claude-agent-acp*) launch claude "$@" ;;
	*codex-acp*) launch codex "$@" ;;
	*pi-acp*) launch pi "$@" ;;
	*amp-acp*) launch amp "$@" ;;
	*)
		echo "npx (e2e fake): no fake for $*" >&2
		exit 1
		;;
	esac
	;;
claude)
	case "$*" in
	--version) echo "2.1.0 (Claude Code)" ;;
	"auth status")
		if logged_out claude; then
			echo '{"loggedIn":false}'
			exit 1
		fi
		echo '{"loggedIn":true,"authMethod":"api_key"}'
		;;
	*) exit 2 ;;
	esac
	;;
codex)
	case "$*" in
	--version) echo "codex-cli 0.90.0" ;;
	"login status")
		if logged_out codex; then
			echo "Not logged in"
			exit 1
		fi
		echo "Logged in using an API key"
		;;
	*) exit 2 ;;
	esac
	;;
amp)
	case "$*" in
	--version) echo "0.0.1791403257-g05ffa9 (released 2026-10-07T20:00:57.000Z, 2h ago)" ;;
	*) exit 2 ;;
	esac
	;;
glue | pool | pi)
	if [ "${1:-}" = --version ]; then
		case "$name" in
		glue) echo "glue v0.9.0 (e2e)" ;;
		pool) echo "pool 1.4.2" ;;
		pi) echo "0.70.2" ;;
		esac
	elif [ "$*" = doctor ]; then
		if logged_out "$name"; then
			echo "Not signed in"
			exit 1
		fi
		echo "All checks passed"
	elif has acp "$@"; then
		launch "$name" "$@"
	else
		exit 2
	fi
	;;
*)
	echo "e2e fake agent: unknown name $name" >&2
	exit 2
	;;
esac
