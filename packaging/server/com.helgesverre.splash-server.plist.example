<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.helgesverre.splash-server</string>
  <key>ProgramArguments</key><array>
    <string>/Users/YOUR_USER/.local/bin/splash-server</string>
    <string>--data-dir</string><string>/Users/YOUR_USER/Library/Application Support/SplashServer</string>
    <string>--name</string><string>Mac server</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>/Users/YOUR_USER/Library/Logs/splash-server.log</string>
  <key>StandardErrorPath</key><string>/Users/YOUR_USER/Library/Logs/splash-server.log</string>
</dict></plist>
